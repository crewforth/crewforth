# A short translation: the class of work a cheaper model may be enough for (M3, Faz 8.2).
#
# Translating a locale file is mechanical on its surface and breaks in the details: a key renamed, a placeholder
# translated or dropped, the source file "fixed" along the way, a string left in English. The grader reads only
# the files: every key of the source is in the translation with its placeholders as written, the values are
# Turkish, and nothing but the new file changed.

DESC="An English locale file translated to Turkish — keys, placeholders and the source kept?"
NEEDS_GIT_OK=0

seed() {
  mkdir -p locales
  cat > locales/en.json <<'JSON'
{
  "cart.title": "Your cart",
  "cart.items": "{count} items in your cart",
  "cart.empty": "Your cart is empty.",
  "checkout.pay": "Pay {amount} now",
  "checkout.terms": "By paying you accept the {terms_link}.",
  "error.network": "Connection lost. Please try again."
}
JSON
}

PROMPT='Translate locales/en.json into Turkish as locales/tr.json. Keep the keys and the {placeholders} exactly as they are.'
